name: Build kernels

env:
  OUT_DIR: "out"

on:
  workflow_dispatch:
    inputs:
      kernelSourceURL:
        description: "Kernel source URL"
        required: true
        type: string
      kernelPrivateSource:
        description: "Is private source?"
        required: false
        type: boolean
        default: false
      kernelBranch:
        description: "Kernel branch"
        required: true
        type: string
      kernelDevice:
        description: "Device (defconfig prefix)"
        required: true
        type: string
        default: "gki"
      kernelSourceName:
        description: "Kernel source folder name"
        required: true
        type: string
      localVersion:
        description: "Custom localversion (e.g. -mybuild)"
        required: false
        type: string
        default: ""
      kernelSUChoice:
        description: "KernelSU Variant"
        required: true
        type: choice
        options:
          - "None"
          - "KernelSU"
          - "KernelSU-Next"
          - "KernelSU-Next + Next-SuSFS"
          - "KernelSU by @rsuntk"
          - "SukiSU"
          - "ReSukiSU"
          - "WKSU"
        default: "KernelSU"
      USE_SUSFS:
        description: "Enable SUSFS (handled by patch manager)"
        required: true
        type: boolean
        default: true
      USE_KPM:
        description: "Enable Kernel Patch Manager"
        required: false
        type: boolean
        default: false
      USE_SUKISU:
        description: "Enable SukiSU-Ultra patches"
        required: false
        type: boolean
        default: false
      APPLY_NOMOUNT:
        type: boolean
        default: true
      APPLY_ZRAM:
        type: boolean
        default: true
      APPLY_BBR:
        type: boolean
        default: true
      APPLY_VFS:
        type: boolean
        default: true
      APPLY_LTO_THIN:
        type: boolean
        default: true
      clangCompiler:
        description: "Clang compiler"
        required: true
        type: choice
        options:
          - "ZyC Clang"
          - "Greenforce Clang"
          - "SuperRyzen Clang"
          - "WeebX Clang"
        default: "ZyC Clang"

jobs:
  build:
    name: "Build Kernel"
    runs-on: ubuntu-latest

    steps:
    - name: Checkout
      uses: actions/checkout@v4

    - name: Create working directory
      run: mkdir -p "${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}"

    - name: Timestamp
      run: echo "BUILD_TIME=$(date +'%Y-%m-%d_%H-%M-%S')" >> $GITHUB_ENV

    - name: Install dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential bc curl flex cpio ccache rsync git zip dwarves libelf-dev \
          gcc-aarch64-linux-gnu gcc-arm-linux-gnueabi libssl-dev lftp zstd wget libfl-dev python3 libarchive-tools \
          clang lld llvm llvm-dev jq

    - name: Clone Kernel Source
      working-directory: ./${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}
      env:
        PRIVATE_SOURCE: ${{ github.event.inputs.kernelSourceURL }}
      run: |
        if [ "${{ github.event.inputs.kernelPrivateSource }}" = "true" ]; then
          if [[ "$PRIVATE_SOURCE" == *"github.com"* ]]; then
            PRIVATE_SOURCE="${PRIVATE_SOURCE#https://github.com/}"
            OWNER=$(echo "$PRIVATE_SOURCE" | cut -d'/' -f1)
            PREFIX="https://$OWNER:${{ secrets.PRIVATE_REPO_TOKEN }}@github.com/"
          elif [[ "$PRIVATE_SOURCE" == *"gitlab.com"* ]]; then
            PRIVATE_SOURCE="${PRIVATE_SOURCE#https://gitlab.com/}"
            OWNER=$(echo "$PRIVATE_SOURCE" | cut -d'/' -f1)
            PREFIX="https://$OWNER:${{ secrets.PRIVATE_REPO_TOKEN }}@gitlab.com/"
          fi
          git clone --depth=1 --branch "${{ github.event.inputs.kernelBranch }}" "$PREFIX$PRIVATE_SOURCE" "${{ github.event.inputs.kernelSourceName }}"
        else
          git clone --depth=1 --branch "${{ github.event.inputs.kernelBranch }}" "${{ github.event.inputs.kernelSourceURL }}" "${{ github.event.inputs.kernelSourceName }}"
        fi

    - name: Download Clang Toolchain
      run: |
        get_latest() {
          curl -sL "https://api.github.com/repos/$1/releases/latest" | grep "browser_download_url.*tar.gz" | cut -d '"' -f 4 | head -n 1
        }

        case "${{ github.event.inputs.clangCompiler }}" in
          "ZyC Clang") URL=$(get_latest "ZyCromerZ/Clang") ;;
          "Greenforce Clang") URL=$(get_latest "greenforce-project/greenforce_clang") ;;
          "SuperRyzen Clang") URL="https://gitlab.com/TianWalkzzMiku/SuperRyzen-Clang/" ;;
          "WeebX Clang") URL=$(get_latest "XSans0/WeebX-Clang") ;;
        esac

        mkdir clang
        if [[ "$URL" == *.tar.gz ]]; then
          wget -O clang/clang.tar.gz "$URL"
          tar -xf clang/clang.tar.gz -C clang
        else
          git clone --depth=1 "$URL" clang
        fi

        CLANG_PATH=$(find clang -type f -name clang | head -n 1 | xargs dirname)
        echo "$CLANG_PATH" >> $GITHUB_PATH
        echo "CLANG_PATH=$CLANG_PATH" >> $GITHUB_ENV

    - name: Configure ccache
      run: |
        echo "CCACHE_DIR=${{ github.workspace }}/.ccache" >> $GITHUB_ENV
        echo "PATH=/usr/lib/ccache:$PATH" >> $GITHUB_ENV

    - name: Apply Patch Manager
      working-directory: ./${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}/${{ github.event.inputs.kernelSourceName }}
      run: |
        chmod +x scripts/patch-scripts.sh
        ./scripts/patch-scripts.sh
      env:
        USE_SUSFS: ${{ github.event.inputs.USE_SUSFS }}
        USE_KPM: ${{ github.event.inputs.USE_KPM }}
        USE_SUKISU: ${{ github.event.inputs.USE_SUKISU }}
        APPLY_NOMOUNT: ${{ github.event.inputs.APPLY_NOMOUNT }}
        APPLY_ZRAM: ${{ github.event.inputs.APPLY_ZRAM }}
        APPLY_BBR: ${{ github.event.inputs.APPLY_BBR }}
        APPLY_VFS: ${{ github.event.inputs.APPLY_VFS }}
        APPLY_LTO_THIN: ${{ github.event.inputs.APPLY_LTO_THIN }}

    - name: Apply KernelSU Variant
      working-directory: ./${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}/${{ github.event.inputs.kernelSourceName }}
      env:
        KSU: ${{ github.event.inputs.kernelSUChoice }}
      run: |
        case "$KSU" in
          "None") echo "Skipping KernelSU" ;;
          "KernelSU") curl -LSs https://raw.githubusercontent.com/tiann/KernelSU/main/kernel/setup.sh | bash -s main ;;
          "KernelSU-Next") curl -LSs https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/stable/kernel/setup.sh | bash -s stable ;;
          "KernelSU-Next + Next-SuSFS") curl -LSs https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/next-susfs/kernel/setup.sh | bash -s next-susfs ;;
          "KernelSU by @rsuntk") curl -LSs https://raw.githubusercontent.com/rsuntk/KernelSU/main/kernel/setup.sh | bash -s main ;;
          "SukiSU") curl -LSs https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU-Ultra/main/kernel/setup.sh | bash -s builtin ;;
          "ReSukiSU") curl -LSs https://raw.githubusercontent.com/ReSukiSU/ReSukiSU/main/kernel/setup.sh | bash -s susfs-ksud ;;
          "WKSU") curl -LSs https://raw.githubusercontent.com/WildKernels/Wild_KSU/stable/kernel/setup.sh | bash -s canary ;;
        esac

    - name: Set Localversion
      working-directory: ./${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}/${{ github.event.inputs.kernelSourceName }}
      run: |
        if [ -n "${{ github.event.inputs.localVersion }}" ]; then
          echo "CONFIG_LOCALVERSION=\"${{ github.event.inputs.localVersion }}\"" >> arch/arm64/configs/${{ github.event.inputs.kernelDevice }}_defconfig
        fi

    - name: Build Defconfig
      working-directory: ./${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}/${{ github.event.inputs.kernelSourceName }}
      run: |
        make O=out ARCH=arm64 LLVM=1 ${{ github.event.inputs.kernelDevice }}_defconfig

    - name: Build Kernel
      working-directory: ./${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}/${{ github.event.inputs.kernelSourceName }}
      run: |
        export KBUILD_BUILD_USER="Jeremy"
        export KBUILD_BUILD_HOST="belowzeroiq"
        make -j$(nproc --all) O=out ARCH=arm64 LLVM=1

    - name: Package AnyKernel3
      working-directory: ./${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}/${{ github.event.inputs.kernelSourceName }}
      run: |
        git clone https://github.com/topnotchfreaks/AnyKernel3.git --depth=1
        cp out/arch/arm64/boot/Image AnyKernel3/
        cd AnyKernel3
        zip -r9 "../kernel_${{ github.event.inputs.kernelDevice }}_${{ env.BUILD_TIME }}.zip" ./*

    - name: Upload Kernel
      uses: actions/upload-artifact@v4
      with:
        name: kernel_${{ github.event.inputs.kernelDevice }}_${{ env.BUILD_TIME }}
        path: ./${{ github.event.inputs.kernelSourceName }}_${{ github.event.inputs.kernelDevice }}/${{ github.event.inputs.kernelSourceName }}/kernel_${{ github.event.inputs.kernelDevice }}_${{ env.BUILD_TIME }}.zip
